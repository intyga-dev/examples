# pnpm run setup creates .env and generates TEST_API_TOKEN without printing it.
PORT=4400
TEST_API_TOKEN=
INTYGA_GATEWAY_URL=http://localhost:8787
INTYGA_WEB_URL=http://localhost:3999
INTYGA_TARGET=intyga-package-test
# Use a human or SERVICE API key for both REST and MCP.
INTYGA_CLIENT_ID=
INTYGA_CLIENT_SECRET=
# Export trusted approvers from the console, review, then save the file here.
INTYGA_TRUST_ANCHOR_FILE=./trust-anchor.json
INTYGA_REQUIRED_APPROVALS=1
# requireApproval wait timeout and poll interval, in milliseconds (both must be positive).
INTYGA_WAIT_TIMEOUT_MS=120000
INTYGA_POLL_INTERVAL_MS=1000
