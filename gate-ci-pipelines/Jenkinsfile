// Gate a production deploy on a signed human approval — Jenkins (declarative pipeline).
//
// Deliberately NOT Jenkins' own `input` step. That records a click by whoever held a session, in a
// log the same platform controls; this records a signature over the exact parameters, verifiable by
// someone who does not trust Jenkins or us. Use both if you like — they answer different questions.

pipeline {
  agent any

  environment {
    INTYGA_TARGET      = 'prod-eu-1'
    INTYGA_ACTION_TYPE = 'deploy_production'
    INTYGA_GATEWAY_URL = credentials('intyga-gateway-url')
    INTYGA_WEB_URL     = credentials('intyga-web-url')
    // A SERVICE identity: it can request an approval and nothing else.
    INTYGA_CLIENT_ID     = credentials('intyga-client-id')
    INTYGA_CLIENT_SECRET = credentials('intyga-client-secret')
    // Required, and yours. A receipt checked against the key inside itself proves nothing.
    INTYGA_APPROVER_KEYS = credentials('intyga-approver-keys')
  }

  stages {
    stage('Build') {
      steps {
        sh 'echo "build the artefact here — no deploy credentials in this stage"'
      }
    }

    stage('Request approval') {
      steps {
        script {
          // The last line of stdout is the machine-readable JSON; a banner precedes it. The GitHub
          // Actions `$GITHUB_OUTPUT` path does not apply here, and the key is `approvalUrl`.
          def params = sh(
            script: """jq -cn --arg sha "\${GIT_COMMIT}" '{sha:\$sha,environment:"production"}'""",
            returnStdout: true,
          ).trim()

          def out = sh(
            script: """
              npx --yes @intyga/sdk authorize "Deploy \${GIT_COMMIT} to production" \
                --gateway "\$INTYGA_GATEWAY_URL" \
                --web "\$INTYGA_WEB_URL" \
                --target "\$INTYGA_TARGET" \
                --type "\$INTYGA_ACTION_TYPE" \
                --params '${params}' \
                --no-wait --no-open | tail -n1
            """,
            returnStdout: true,
          ).trim()

          env.INTYGA_NONCE  = sh(script: "printf '%s' '${out}' | jq -r .nonce", returnStdout: true).trim()
          env.INTYGA_PARAMS = params
          def url = sh(script: "printf '%s' '${out}' | jq -r .approvalUrl", returnStdout: true).trim()
          echo "Approve at: ${url}"

          if (env.INTYGA_SLACK_WEBHOOK) {
            sh """
              npx --yes @intyga/sdk notify \
                --url '${url}' \
                --context 'Deploy \${GIT_COMMIT} to production' \
                --slack "\$INTYGA_SLACK_WEBHOOK"
            """
          }
        }
      }
    }

    stage('Deploy') {
      steps {
        // Blocks until signed, verifies the receipt, redeems it single-use. A non-zero exit fails the
        // build before ./deploy.sh runs — which is the entire gate. Do not wrap it in catchError.
        sh """
          npx --yes @intyga/sdk await "\$INTYGA_NONCE" \
            --gateway "\$INTYGA_GATEWAY_URL" \
            --target "\$INTYGA_TARGET" \
            --type "\$INTYGA_ACTION_TYPE" \
            --params '${env.INTYGA_PARAMS}' \
            --timeout 1800 --consume
        """
        sh './deploy.sh'
      }
    }
  }
}
